# Domain Blocker Configuration
# Location: /etc/domain-blocker/config.env (installed from this template)

# Schedule Configuration
# Multiple time slots separated by commas in 24-hour HH:MM-HH:MM format
SCHEDULE_SLOTS="07:00-11:00,18:00-22:00"

# Days of week when schedule is active:
# Options: "all" or comma-separated "Mon,Tue,Wed,Thu,Fri,Sat,Sun"
SCHEDULE_DAYS="all"

# Desktop notification warning before block starts (in minutes; 0 to disable)
PRE_BLOCK_WARN_MINUTES=2

# Enforcement Features (1 = enabled, 0 = disabled)
ENFORCE_FIREWALL=1
ENFORCE_BROWSER_POLICIES=1
KILL_ACTIVE_SOCKETS=1
WILDCARD_ROUTING=1

# Working paths
CONFIG_DIR="/etc/domain-blocker"
STATE_DIR="/run/domain-blocker"
HOSTS_FILE="/etc/hosts"
HOSTS_BACKUP="/etc/domain-blocker/hosts.original"
