#!/usr/sbin/nft -f
# Isolated nftables ruleset for Domain Blocker
# Managed automatically by /usr/local/bin/domain-blocker

table inet domain_blocker {
    set doh_ipv4 {
        type ipv4_addr
        flags interval
        elements = {
            1.1.1.1,
            1.0.0.1,
            8.8.8.8,
            8.8.4.4,
            9.9.9.9,
            149.112.112.112,
            208.67.222.222,
            208.67.220.220,
            94.140.14.14,
            94.140.15.15
        }
    }

    set doh_ipv6 {
        type ipv6_addr
        flags interval
        elements = {
            2606:4700:4700::1111,
            2606:4700:4700::1001,
            2001:4860:4860::8888,
            2001:4860:4860::8844,
            2620:fe::fe,
            2620:fe::9
        }
    }

    chain output {
        type filter hook output priority filter; policy accept;

        # Always preserve loopback traffic unconditionally
        oifname "lo" accept

        # Block DNS-over-TLS (port 853) across all remote interfaces
        tcp dport 853 reject with tcp reset
        udp dport 853 reject with icmpx type admin-prohibited

        # Block public DoH resolvers on port 443 so browsers cannot bypass local DNS
        ip daddr @doh_ipv4 tcp dport 443 reject with tcp reset
        ip6 daddr @doh_ipv6 tcp dport 443 reject with icmpx type admin-prohibited
        ip daddr @doh_ipv4 udp dport 443 reject with icmpx type admin-prohibited
        ip6 daddr @doh_ipv6 udp dport 443 reject with icmpx type admin-prohibited
    }
}
